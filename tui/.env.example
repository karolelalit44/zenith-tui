# Zenith TUI configuration
# Copy this file to .env (which is gitignored) and adjust values.
# Loaded at startup by src/config/env.ts (values here are the source of truth;
# real shell environment variables always win over this file).

# Backend base URL (HTTP). The TUI derives the WebSocket URL from this.
ZENITH_BACKEND_URL=http://127.0.0.1:8765

# WebSocket route. /ws/test = simulation backend, /ws = production backend.
ZENITH_WS_PATH=/ws/test

# Backend HTTP fetch timeout (ms)
VITE_BACKEND_FETCH_TIMEOUT=10000

# WebSocket RPC timeout (ms)
ZENITH_WS_RPC_TIMEOUT=60000

# WebSocket reconnect policy
ZENITH_WS_MAX_RECONNECT=5
ZENITH_WS_RECONNECT_DELAY=1000

# Backend staleness guard: emit STALE_TIMEOUT if no event arrives this long (ms),
# and give up reconnecting after this long with no resume (ms).
ZENITH_WS_STALE_TIMEOUT_MS=600000
ZENITH_WS_RECONNECT_WAIT_MS=20000

# Git integration (timeout in seconds)
ZENITH_GIT_CACHE_TTL=30000
ZENITH_GIT_TIMEOUT=30

# Startup connection retry policy
ZENITH_STARTUP_RETRIES=30
ZENITH_STARTUP_RETRY_DELAY_MS=250
ZENITH_STARTUP_RETRY_MAX_DELAY_MS=1000

# Model defaults
VITE_DEFAULT_TEMPERATURE=0.7
VITE_FALLBACK_MAX_TOKENS=4096

# Context-pressure thresholds (fractions 0..1)
ZENITH_CONTEXT_ATTENTION=0.7
ZENITH_CONTEXT_PREPARING=0.85
ZENITH_CONTEXT_REQUIRED=0.95
