# ── Zenith Environment Configuration ──────────────────────────────────
# Copy to .env and fill in your values.
# Every required var MUST be set — no fallbacks, no defaults.
# ──────────────────────────────────────────────────────────────────────

# ── Provider ──────────────────────────────────────────────────────────
ZENITH_ACTIVE_PROVIDER=nvidia

# ── Database ──────────────────────────────────────────────────────────
ZENITH_DB_PATH=data/zenith.db

# ── Logging ──────────────────────────────────────────────────────────
ZENITH_LOG_LEVEL=info

# ── Context / Token Budget ────────────────────────────────────────────
ZENITH_MAX_CONTEXT_TOKENS=128000
ZENITH_SUMMARY_THRESHOLD=0.8

# ── Agent Loop ────────────────────────────────────────────────────────
ZENITH_MAX_ITERATIONS=10
ZENITH_MAX_TOOL_OUTPUT=10000

# ── Bash / Tool Timeouts (seconds) ────────────────────────────────────
ZENITH_BASH_TIMEOUT=30
ZENITH_GIT_TIMEOUT=30

# ── Web Fetch ─────────────────────────────────────────────────────────
ZENITH_WEBFETCH_TIMEOUT=30
ZENITH_WEBFETCH_MAX_BYTES=50000

# ── Retry / Backoff ──────────────────────────────────────────────────
ZENITH_MAX_RETRIES=3
ZENITH_STREAM_MAX_RETRIES=2
ZENITH_RETRY_BASE_DELAY=1.0
ZENITH_RETRY_MAX_DELAY=60.0

# ── Provider Validation Timeout (seconds) ────────────────────────────
ZENITH_VALIDATION_TIMEOUT=30

# ── Provider Defaults ─────────────────────────────────────────────────
ZENITH_MAX_TOKENS=4096
ZENITH_TEMPERATURE=0.7

# ── Backend Server ────────────────────────────────────────────────────
ZENITH_HOST=localhost
ZENITH_PORT=8765

# ── Frontend (Vite) ──────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8765
VITE_BACKEND_FETCH_TIMEOUT=5000
VITE_DEFAULT_MAX_TOKENS=4096
VITE_DEFAULT_TEMPERATURE=0.7
VITE_FALLBACK_MAX_TOKENS=30000

# ── WebSocket Client ──────────────────────────────────────────────────
ZENITH_WS_MAX_RECONNECT=5
ZENITH_WS_RECONNECT_DELAY=1000
ZENITH_WS_RPC_TIMEOUT=60000

# ── Git Cache ─────────────────────────────────────────────────────────
ZENITH_GIT_CACHE_TTL=30000

# ── Validation ────────────────────────────────────────────────────────
# Set to "true" to exit on config warnings (missing API keys, etc.)
# Leave unset or empty for normal operation.
ZENITH_STRICT_VALIDATION=

# ── MCP Servers (JSON) ────────────────────────────────────────────────
# Optional. Enables MCP integration: each server's tools are registered
# as mcp_<server>_<tool> in the tool registry.
# Example — filesystem server:
# ZENITH_MCP_SERVERS={"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}}

# ── Repo Map ─────────────────────────────────────────────────────────
# Optional. Injects a token-budgeted, ranked repo map into the system
# prompt so the model sees the repository structure before history.
# ZENITH_REPO_MAP_TOKENS=4096

# ── Lifecycle Hooks (JSON) ────────────────────────────────────────────
# Optional. Config-driven shell hooks (HP-10). Each command runs in the
# workspace root with a JSON payload on stdin; {tool_name}, {session_id},
# {params}, ... template fields are substituted into the command.
#   pre_tool_use:  run before a tool executes; non-zero exit blocks it.
#   post_tool_use: run after a tool executes (lint, formatting, ...).
#   session_start: run once when a session is created.
# Example — block bash unless a guard script allows it, run ruff after edits:
# ZENITH_HOOKS={"pre_tool_use":["bash ./guard.sh"],"post_tool_use":["if [ \"{tool_name}\" = \"file_edit\" ]; then ruff check .; fi"],"session_start":["echo session {session_id} started"],"timeout":30}
